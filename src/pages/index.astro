---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const entries = (await getCollection("diary")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const dateFormat = new Intl.DateTimeFormat("en-NZ", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout title="Conrad Wilson — Software Engineer">

  <nav class="cta-row" aria-label="Page sections">
    <a href="#about">About</a>
    <a href="#diary">Coding Diary</a>
    <a href="#contact">Contact</a>
  </nav>

  <header class="hero">
    <h1>In pursuit of <i>Knowledge</i></h1>

    <div class="flex justify-center gap-6">
      <a
        class="git-button"
        href="https://github.com/w0zzah"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub profile"></a>
      <a
        class="linkedin-button"
        href="https://www.linkedin.com/in/conrad-wilsonn/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn profile"></a>
    </div>
  </header>

  <main>
    <div class="wrap">
      <section class="About" id="about">
        <div class="grid gap-[clamp(36px,5vw,72px)] md:grid-cols-[1.3fr_1fr]">
          <div>
            <h2>General Info</h2>
            <p class="mb-[18px]">
              Hello! I'm Conrad Wilson, a software engineering student at the
              University of Canterbury, studying with the intent to develop and
              expand my current skills.
            </p>
            <p class="mb-[18px]">
              I chose software engineering as the environment
              keeps me on my feet, and the opportunity to create something
              from scratch is very fulfilling!
            </p>
            <p class="mb-[18px]">
              While I have enjoyed solo projects, team projects is where my true
              passion lies. Over the past year I have worked with others to
              co-develop large projects that were very well received.
            </p>
            <p class="mb-[18px]">
              I'm drawn to work that lets me grow and develop my skills further,
              preferably with real impact and benefit. Outside of study, I spend
              most of my time at the gym or playing video games.
            </p>
            <a class="btn" href="src/content/downloads/conrad_wilson_cv.pdf" download>View My CV (PDF)</a>
            </div>
            <div>
                <h2>Projects</h2>
                  <div>
                    <h3>Generate a Pub Crawl!</h3>
                    <p class="mb-[18px]">
                     Looking to go for a pub-crawl in Christchurch? Struggling to find the right route?
                     Well "Route-Beer" has you covered! This university project developed using JavaFX over
                     6 months with a team of 4 people.
                    </p>
                    <a class="btn" href="src/content/downloads/route_beer.zip" download>Download App (Jar File)</a>
                    <a class="btn" href="https://github.com/w0zzah/Route-Beer" download>View Repository</a>
                    <h3>Turn based pixel game!</h3>
                    <p class="mb-[18px]">
                      "Nun' But Blood" is a turn based rogue-like where each run you hire a party of
                      saint's to help exorcise demons. Developed using JavaFX with a partner.
                    </p>
                    <a class="btn" href="https://github.com/w0zzah/Nun-But-Blood" download>View Repository</a>

                  </div>
            </div>
      </section>

      <section class="diary" id="diary">
        <h2>Learning Diary</h2>
            <ul class="diary-list">
              {entries.map((entry) => (
                <li>
                  <a class="diary-link" href={`/website-astro/diary/${entry.id}/`}>
                    <time datetime={entry.data.date.toISOString()}>
                      {dateFormat.format(entry.data.date)}
                    </time>
                    <h3>{entry.data.title}</h3>
                    {entry.data.summary && <p class="text-muted">{entry.data.summary}</p>}
                  </a>
                </li>
              ))}
            </ul>
      </section>

      <section class="contact" id="contact">
        <h2>Reach out anytime</h2>
        <h3 class="contact-details">
          <a href="mailto:conradwilsonn@gmail.com">conradwilsonn@gmail.com</a>
          <span aria-hidden="true">|</span>
          <a href="tel:+64204836895">+64 20 483 6895</a>
        </h3>
      </section>
    </div>
  </main>
</BaseLayout>
